
# --- Destino ---
TELEMETRY_ENABLED=1

# Endpoint del gateway regional. Tal como lo da la consola: SIN /v1/logs. La app
# lo normaliza y añade la ruta de la señal, así que también vale con ella puesta.
TELEMETRY_OTLP_URL=endpoint_regional

# Basic auth. El usuario es el Instance ID de la consola, NO el campo "o" que
# va dentro del token: con ese otro valor el gateway responde 401.
TELEMETRY_USER=12345

# Token de API. El que se recommends es el "otlp-write" acotado al stack, que
# solo puede escribir logs y no da acceso a nada más.
TELEMETRY_PASSWORD=pega-aqui-el-token-glc

# --- Privacidad ---
# Salt del hash de IP. Pon uno propio y largo: sin salt el hash se puede
# revertir con una tabla de IPs conocidas. Cambiarlo hace los registros
# antiguos incomparables con los nuevos.
TELEMETRY_HASH_SALT=cambia-esto-por-una-cadena-larga-y-aleatoria

# --- Fichero local ---
# Carpeta para streaming.log, events.jsonl y spool.jsonl. Sin esto, solo stdout
# y nada se conserva entre reinicios.
TELEMETRY_LOG_DIR=./logs

# --- Ajustes (opcionales, estos son los valores por defecto) ---
# TELEMETRY_LOG_MAX_BYTES=8388608
# TELEMETRY_LOG_MAX_FILES=5
# TELEMETRY_FLUSH_MS=5000
# TELEMETRY_MAX_BATCH=200
# TELEMETRY_BUFFER=2000
# TELEMETRY_SPOOL_BYTES=16777216
# TELEMETRY_EXPORT_LOGS=1

# --- Alternativa: que las claves vinieran de Infisical ---
# Solo rellenan lo que esté vacío, así que lo de arriba manda. El token de
# Infisical va aquí o en el entorno, NUNCA dentro del binario: portable.exe se
# publica en un release público de GitHub y cualquier -ldflags -X se lee con
# strings.
# INFISICAL_ENABLED=0
# INFISICAL_TOKEN=pega-aqui-el-service-token-st....
# INFISICAL_PROJECT_ID=el-id-del-proyecto
# INFISICAL_ENV=prod
# INFISICAL_PATH=/path_vuestro

# --- Acceso a /api/logs ---
# El servidor escucha en 0.0.0.0, así que /api/logs solo responde a loopback
# si no defines esto. Ponlo si quieres leerlo desde otro equipo:
# TELEMETRY_API_TOKEN=una-cadena-aleatoria